AGENT_MODE=booking
WSS_API_KEY=your_telcoflow_api_key
WSS_CONNECTOR_UUID=your_telcoflow_connector_uuid
GOOGLE_API_KEY=your_google_api_key
OPENCLAW_AGENT=main
OPENCLAW_TIMEOUT_SECONDS=900
GOOGLE_CALENDAR_CREDENTIALS=/absolute/path/to/google-calendar-credentials.json
GOOGLE_CALENDAR_CREDENTIALS_JSON=
PORT=8080
OPENCLAW_GATEWAY_PORT=8080
OPENCLAW_GATEWAY_TOKEN=replace_with_a_long_random_token
OPENCLAW_STATE_DIR=/data/.openclaw
OPENCLAW_WORKSPACE_DIR=/data/workspace
OPENCLAW_CONFIG_PATH=/data/.openclaw/openclaw.json
OPENCLAW_BOOT_DELAY_SECONDS=5
BOOKINGS_PATH=/data/bookings.json
